# Minh họa theo ADR 0008 và issue #85, không phải toàn bộ luồng fallback.
direction: down
vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 1
  }
}
classes: {
  before: {
    style.fill: "#F1F5F9"
    style.stroke: "#64748B"
    style.font-size: 20
  }
  after: {
    style.fill: "#EFF6FF"
    style.stroke: "#2563EB"
    style.font-size: 20
  }
}
title: "THAY ĐỔI MODEL 1, 3 VÀ 4\nBackend và demo Streamlit • 29/10/2026" {
  shape: text
  near: top-center
  style.font-size: 28
}
model1: "01 • MODEL 1 — PHÂN LOẠI GIAO DỊCH" {
  grid-columns: 2
  direction: right
  style.fill: "#FFFFFF"
  before: "TRƯỚC\n\nNạp classifier khi có yêu cầu đầu tiên\nBackend và Streamlit có bộ nạp riêng\nMột giao dịch cần fallback có thể\nchạy phân loại cục bộ hai lần" { class: before }
  after: "SAU\n\nDùng chung mã bộ nạp classifier\nCache model trong từng tiến trình\nBackend nạp sẵn + chạy mẫu lúc khởi động\nFallback dùng lại kết quả phân loại lần đầu\nLoRA merge trong RAM: tùy chọn, mặc định tắt" { class: after }
}
model3: "02 • MODEL 3 + MODEL 1 — MỘT CHỨC NĂNG NHẬP GIAO DỊCH" {
  grid-columns: 2
  direction: right
  style.fill: "#FFFFFF"
  before: "TRƯỚC\n\nChữ → chuẩn hóa → Model 1\nAudio → PhoWhisper → chữ → Model 1\nNhánh ASR sang classifier đã có sẵn\nModel có thể được nạp ngay lúc demo" { class: before }
  after: "SAU\n\nChữ và transcript dùng chung parser\nCó hàm kết hợp ASR → parser ở backend\nModel 1 dùng runtime cache chung mã\nStreamlit có nút nạp trước Model 1 + ASR\nASR và classifier vẫn là hai model riêng" { class: after }
}
model4: "03 • MODEL 4 — ĐỌC HÓA ĐƠN, GIỮ RIÊNG" {
  grid-columns: 2
  direction: right
  style.fill: "#FFFFFF"
  before: "TRƯỚC\n\nQwen đọc ảnh → JSON và danh mục\nNhánh Qwen thành công không cần Model 1\nDemo tạo và đóng HTTP client mỗi lượt\nHook backend chưa gắn receipt adapter" { class: before }
  after: "SAU\n\nQwen và kiểm định hóa đơn giữ nguyên\nBackend sở hữu adapter + pool kết nối\nHook tái sử dụng pool trong vòng đời backend\nĐóng pool khi backend dừng\nStreamlit vẫn giữ client theo từng lượt" { class: after }
}
model1 -> model3 -> model4: { style.opacity: 0 }
footer: "PHẠM VI VÀ CÁCH ĐỌC\nFlutter/app và Model 2 không thay đổi. Chưa thêm API upload audio/ảnh mới.\nCache dùng chung theo tiến trình; backend và Streamlit chạy riêng vẫn có bộ nhớ riêng.\nWarm-up chuyển thời gian chờ sang bước chuẩn bị, không xóa chi phí nạp model.\nSơ đồ chỉ nêu thay đổi; không mô tả đầy đủ các nhánh Gemini fallback." {
  shape: text
  style.font-size: 18
}
model4 -> footer: { style.opacity: 0 }
