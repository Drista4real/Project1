REDIS_URL=redis://localhost:6379/0
CLASSIFIER_BACKEND=lightgbm
# Set CLASSIFIER_BACKEND=lora after preparing the adapter and base-model cache.
CLASSIFIER_DEVICE=cpu
# Prepare local classifier before serving; never calls cloud or downloads weights.
CLASSIFIER_WARMUP=true
# Merge LoRA into the base model in RAM only; restart after changing settings.
CLASSIFIER_LORA_MERGE=false
# Tune per CPU/deployment; leave unset to retain PyTorch's default thread count.
# CLASSIFIER_CPU_THREADS=2
# Defaults are absolute paths inside this repository; override with absolute paths.
# CLASSIFIER_LORA_DIR=D:/Project1_TPN/Project1/weights/checkpoints/classifier_lora
# CLASSIFIER_LORA_CACHE_DIR=D:/Project1_TPN/Project1/weights/cache/phobert-lora
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Model 4 (docs/SPECIFICATION.md, section 5.2): separate provider credentials.
# Leave keys empty for mock mode. Put real keys only in backend/.env.

# Receipt extraction only: get the API key from FPT Cloud Marketplace.
# https://marketplace.fptcloud.com/en/models/qwen2.5-vl-7b-instruct
FPT_API_KEY=
QWEN_BASE_URL=https://mkp-api.fptcloud.com/v1
QWEN_MODEL=Qwen2.5-VL-7B-Instruct

# Financial advice only: create a Gemini API key in Google AI Studio.
# https://aistudio.google.com/apikey
# Gemini NLP fallback is specified but is not implemented in the current demo.
GEMINI_API_KEY=
# New Gemini accounts may not have access to the original 2.5 Flash model.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_INPUT_MODEL=gemini-3.1-flash-lite
