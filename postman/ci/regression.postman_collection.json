        "url": "{{base_url}}/api/v1/manage/accounts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman regression\",\n  \"account_type\": \"cash\",\n  \"balance\": \"100000.10\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const data = pm.response.json();",
              "pm.test(\"Wallet belongs to user\", () => pm.expect(data.user_id).to.equal(pm.collectionVariables.get(\"user_id\")));",
              "pm.collectionVariables.set(\"wallet_id\", String(data.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Read starting balance",
      "request": {
        "method": "GET",
        "header": [
