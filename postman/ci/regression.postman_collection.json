{
  "info": {
    "name": "Kakeibo disposable CI regression",
    "description": "Ordered regression against tests/backend-e2e disposable services only. Run with postman/ci/run.mjs; never supply a deployed API or production Supabase. No Postman cloud ID or login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.variables.get(\"base_url\") !== \"https://postman-gateway:8443\" || pm.variables.get(\"supabase_url\") !== \"https://postman-gateway:8443\" || pm.variables.get(\"test_scope\") !== \"disposable-ci\") { throw new Error(\"Use disposable CI services only\"); }",
          "if (!pm.collectionVariables.get(\"email\")) {",
          " const id = pm.variables.replaceIn(\"{{$guid}}\");",
          " pm.collectionVariables.set(\"email\", \"postman-\" + id + \"@example.com\");",
          " pm.collectionVariables.set(\"password\", \"Ci!\" + pm.variables.replaceIn(\"{{$guid}}\"));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Public health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Process is healthy\", () => pm.expect(pm.response.json()).to.deep.equal({status: \"ok\"}));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 OpenAPI exposes implemented operations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/openapi.json",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"API contract\", () => {",
              " const paths = pm.response.json().paths;",
              " pm.expect(paths[\"/api/v1/ingestion/text\"]).to.have.property(\"post\");",
              " pm.expect(paths[\"/api/v1/transactions\"]).to.have.property(\"post\");",
              " pm.expect(paths[\"/api/v1/transactions/{transaction_id}\"]).to.include.keys(\"get\", \"patch\", \"delete\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Missing token is rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/transactions",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "pm.test(\"Bearer challenge\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.equal(\"Bearer\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Invalid token is rejected",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/transactions",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "invalid-token",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Sign up isolated user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{supabase_url}}/auth/v1/signup",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"User created\", () => pm.expect(pm.response.json().user.id).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Password login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{supabase_url}}/auth/v1/token?grant_type=password",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"User session issued\", () => {",
              " pm.expect(Boolean(data.access_token && data.refresh_token && data.user.id)).to.equal(true);",
              "});",
              "pm.collectionVariables.set(\"access_token\", data.access_token);",
              "pm.collectionVariables.set(\"refresh_token\", data.refresh_token);",
              "pm.collectionVariables.set(\"user_id\", data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Refresh session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{supabase_publishable_key}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{supabase_url}}/auth/v1/token?grant_type=refresh_token",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"Refresh preserves user\", () => pm.expect(data.user.id).to.equal(pm.collectionVariables.get(\"user_id\")));",
              "pm.test(\"New session issued\", () => pm.expect(Boolean(data.access_token && data.refresh_token)).to.equal(true));",
              "pm.collectionVariables.set(\"access_token\", data.access_token);",
              "pm.collectionVariables.set(\"refresh_token\", data.refresh_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Create dedicated wallet",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
