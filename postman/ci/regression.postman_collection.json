      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Wallet balance 100000.1\", () => pm.expect(Math.round(Number(pm.response.json().balance) * 100)).to.equal(10000010));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Analyze Vietnamese input without saving",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/v1/ingestion/text",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"ăn trưa 65k\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Editable draft contract\", () => pm.response.to.have.jsonSchema({",
              " type: \"object\", required: [\"drafts\"], properties: {drafts: {type: \"array\", minItems: 1, maxItems: 5, items: {",
              " type: \"object\", required: [\"text\", \"normalized_text\", \"amount\", \"transaction_type\", \"category\", \"confidence\", \"source\", \"warnings\"],",
              " properties: {text: {type: \"string\"}, normalized_text: {type: \"string\"}, amount: {type: [\"integer\", \"null\"]},",
              " transaction_type: {enum: [\"income\", \"expense\", \"transfer\"]}, category: {type: [\"string\", \"null\"]},",
              " confidence: {type: \"number\", minimum: 0, maximum: 1}, source: {enum: [\"LOCAL\", \"GEMINI\", \"RULES\", \"UNAVAILABLE\"]},",
              " warnings: {type: \"array\", items: {type: \"string\"}}}",
              " }}}}));",
              "pm.test(\"Deterministic money extraction\", () => {",
              " const draft = pm.response.json().drafts[0];",
              " pm.expect(draft.amount).to.equal(65000);",
              " pm.expect(draft.transaction_type).to.equal(\"expense\");",
              " pm.expect(draft).not.to.have.property(\"id\");",
              " pm.collectionVariables.set(\"draft_amount\", String(draft.amount));",
              "});"
            ]
          }
        }
      ]
    },
